---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import BackgroundFx from '../components/BackgroundFx.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VOSS — Vidyalankar Open Source Software Labs',
  description = 'A student-run open-source lab at Vidyalankar Institute of Technology, Mumbai. We build real digital infrastructure — collaboratively, transparently, and in public.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#050508" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <BackgroundFx />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
