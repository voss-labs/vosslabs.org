---
const beginnerSteps = [
  'Read the <code>CONTRIBUTING.md</code> in the project you\'re interested in',
  'Set up the project locally following the README',
  'Pick a <code>good-first-issue</code> — these are scoped specifically for first-time contributors',
  'Ask questions in the issue thread or on Discord if you\'re stuck',
  'Submit your PR — we review within 48 hours',
];
---

<section class="section" id="start">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">06 — Begin</span>
      <h2 class="section-title">Two paths in.</h2>
    </div>
    <div class="start-grid">
      <div class="start-card" data-reveal>
        <span class="start-num">A</span>
        <h3>New to open source</h3>
        <ol>
          {beginnerSteps.map((step) => <li set:html={step} />)}
        </ol>
      </div>
      <div class="start-card" data-reveal>
        <span class="start-num">B</span>
        <h3>Done this before</h3>
        <p>
          Skip the training wheels. Browse any open issue labeled <code>intermediate</code> or
          <code>advanced</code>, comment to claim it, and start building.
        </p>
        <p>We trust you to read the codebase, follow conventions, and open clean PRs.</p>
        <a href="https://github.com/voss-labs" class="link-arrow" target="_blank" rel="noopener">
          View all issues →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .start-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .start-card {
    padding: 48px 48px 48px 0;
    border-right: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .start-card:last-child {
    border-right: none;
    padding-left: 48px;
    padding-right: 0;
  }

  .start-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 32px;
  }

  .start-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 28px;
  }

  .start-card ol {
    list-style: none;
    counter-reset: item;
  }

  .start-card ol li {
    counter-increment: item;
    position: relative;
    padding-left: 36px;
    margin-bottom: 16px;
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.55;
  }

  .start-card ol li::before {
    content: counter(item, decimal-leading-zero);
    position: absolute;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    top: 4px;
  }

  .start-card p {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.55;
    margin-bottom: 18px;
  }

  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--brand);
    padding-bottom: 2px;
    transition: gap 0.2s var(--transition);
  }

  .link-arrow:hover {
    gap: 10px;
  }

  @media (max-width: 768px) {
    .start-grid {
      grid-template-columns: 1fr;
    }
    .start-card {
      padding: 32px 0;
      border-right: none;
      border-bottom: 1px solid var(--border);
    }
    .start-card:last-child {
      padding-left: 0;
      border-bottom: none;
    }
  }
</style>
