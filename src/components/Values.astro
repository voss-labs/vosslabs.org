---
const values = [
  {
    num: '01',
    title: 'Ship over talk',
    body: 'Working code beats perfect plans. Merge early, iterate often.',
  },
  {
    num: '02',
    title: 'Open by default',
    body: 'Every line of code is public. Every decision is documented. No private repos, no closed meetings.',
  },
  {
    num: '03',
    title: 'Merit over seniority',
    body: "A first-year who ships outranks a final-year who doesn't. Year of study and CGPA are irrelevant here.",
  },
  {
    num: '04',
    title: 'Problems first',
    body: 'We build what Vidyalankar actually needs, not what looks good on a poster.',
  },
];
---

<section class="section" id="values">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">06 — Principles</span>
      <h2 class="section-title">Four non-negotiables.</h2>
      <p class="section-desc">The rules that guide every decision we make.</p>
    </div>

    <div class="values">
      {
        values.map((value) => (
          <div class="value" data-reveal>
            <div class="value-num-wrap">
              <span class="value-num">{value.num}</span>
            </div>
            <div class="value-body">
              <h3>{value.title}</h3>
              <p>{value.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .value {
    display: grid;
    grid-template-columns: minmax(0, 160px) 1fr;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
    transition: border-color 0.35s var(--transition);
  }

  .value-num-wrap {
    padding-top: 0;
  }

  .value-num {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    font-weight: 500;
    color: var(--brand);
    letter-spacing: -0.02em;
    line-height: 1;
    display: block;
  }

  .value-body h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-bottom: 8px;
    color: var(--text);
    max-width: 720px;
    transition: color 0.2s var(--transition);
  }

  .value:hover .value-body h3 {
    color: var(--brand);
  }

  .value-body p {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.45;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .value {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 40px 0;
    }
  }
</style>
