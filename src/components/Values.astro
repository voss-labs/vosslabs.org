---
const values = [
  {
    num: '01',
    title: 'Ship over talk',
    body: 'Working code beats perfect plans. Merge early, iterate often.',
  },
  {
    num: '02',
    title: 'Open by default',
    body: 'Every line of code is public. Every decision is documented. No private repos, no closed meetings.',
  },
  {
    num: '03',
    title: 'Merit over seniority',
    body: "A first-year who ships outranks a final-year who doesn't. Year of study and CGPA are irrelevant here.",
  },
  {
    num: '04',
    title: 'Problems first',
    body: 'We build what Vidyalankar actually needs, not what looks good on a poster.',
  },
];
---

<section class="section" id="values">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">05 — Principles</span>
      <h2 class="section-title">Four non-negotiables.</h2>
      <p class="section-desc">The rules that guide every decision we make.</p>
    </div>
    <div class="values">
      {
        values.map((value) => (
          <div class="value" data-reveal>
            <span class="value-num">{value.num}</span>
            <h3>{value.title}</h3>
            <p>{value.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .values {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .value {
    padding: 40px 32px 40px 0;
    border-bottom: 1px solid var(--border);
    border-right: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .value:nth-child(2n) {
    border-right: none;
    padding-right: 0;
    padding-left: 32px;
  }

  .value:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .value-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 32px;
  }

  .value h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 10px;
  }

  .value p {
    color: var(--text-dim);
    font-size: 0.98rem;
    line-height: 1.55;
    max-width: 480px;
  }

  @media (max-width: 768px) {
    .values {
      grid-template-columns: 1fr;
    }
    .value {
      padding: 32px 0;
      border-right: none;
    }
    .value:nth-child(2n) {
      padding-left: 0;
    }
    .value:nth-last-child(-n+2) {
      border-bottom: 1px solid var(--border);
    }
    .value:last-child {
      border-bottom: none;
    }
  }
</style>
