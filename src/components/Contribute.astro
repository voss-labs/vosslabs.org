---
const steps = [
  {
    num: '01',
    title: 'Browse open issues',
    body: 'Look across our repositories. Filter by <code>good-first-issue</code> if you\'re new.',
  },
  {
    num: '02',
    title: 'Pick something that fits',
    body: 'Match it to your skill level. <code>good-first-issue</code> for beginners, <code>intermediate</code> or <code>advanced</code> for the rest.',
  },
  {
    num: '03',
    title: 'Fork, build, submit a PR',
    body: 'Set up locally, build your solution in a feature branch, open a pull request with a clear description.',
  },
  {
    num: '04',
    title: "Get reviewed and merged",
    body: "We review within 48 hours. Once merged, you're a contributor.",
  },
];
---

<section class="section" id="contribute">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">03 — Join</span>
      <h2 class="section-title">No applications. No interviews.</h2>
      <p class="section-desc">No forms, no committees, no gatekeepers. You contribute, you're in.</p>
    </div>

    <div class="contribute-grid">
      <ol class="steps" data-reveal>
        {
          steps.map((step) => (
            <li class="step">
              <span class="step-num">{step.num}</span>
              <div class="step-content">
                <h3>{step.title}</h3>
                <p set:html={step.body} />
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="terminal" data-reveal>
        <div class="terminal-header">
          <span class="terminal-title">~/voss-labs/&lt;project&gt; — zsh</span>
        </div>
        <pre class="terminal-body"><code><span class="prompt">$</span> <span class="cmd">git</span> clone https://github.com/voss-labs/&lt;project&gt;
<span class="prompt">$</span> <span class="cmd">cd</span> &lt;project&gt; <span class="dim"># follow README to set up</span>
<span class="prompt">$</span> <span class="cmd">git</span> checkout -b feat/your-fix

<span class="dim"># ...build your solution...</span>

<span class="prompt">$</span> <span class="cmd">git</span> add .
<span class="prompt">$</span> <span class="cmd">git</span> commit -m <span class="str">"feat: short description"</span>
<span class="prompt">$</span> <span class="cmd">git</span> push -u origin feat/your-fix
<span class="prompt">$</span> <span class="cmd">gh</span> pr create --fill

<span class="ok">✓ pull request opened</span>
<span class="dim"># reviewed within 48h.</span></code></pre>
      </aside>
    </div>

    <div class="contribute-cta" data-reveal>
      <p class="big-quote">Your GitHub contribution history is your membership card.</p>
      <a href="https://github.com/voss-labs" class="btn btn-primary btn-large" target="_blank" rel="noopener noreferrer">
        <span>Explore Repositories</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .contribute-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
    margin-bottom: 40px;
  }

  .steps {
    list-style: none;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .step {
    display: flex;
    gap: 20px;
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
    transition: border-color 0.35s var(--transition);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-width: 36px;
    line-height: 1.6;
    flex-shrink: 0;
    padding-top: 3px;
  }

  .step-content h3 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    color: var(--text);
    transition: color 0.2s var(--transition);
  }

  .step:hover .step-content h3 {
    color: var(--brand);
  }

  .step-content p {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .terminal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: sticky;
    top: 100px;
    transition:
      background-color 0.35s var(--transition),
      border-color 0.35s var(--transition);
  }

  .terminal-header {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .terminal-body {
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    overflow-x: auto;
    color: var(--text);
    scrollbar-width: thin;
    scrollbar-color: var(--border-hover) transparent;
  }

  .terminal-body::-webkit-scrollbar {
    height: 6px;
  }

  .terminal-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .terminal-body::-webkit-scrollbar-thumb {
    background: var(--border-hover);
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .terminal-body {
      font-size: 0.72rem;
      padding: 14px 14px;
    }
  }

  .terminal-body :global(code) {
    background: none;
    padding: 0;
    font-family: inherit;
    border: none;
    color: var(--text);
  }

  .prompt { color: var(--brand); font-weight: 600; }
  .cmd    { color: var(--token-function); font-weight: 600; }
  .dim    { color: var(--token-comment); font-style: italic; }
  .str    { color: var(--token-string); }
  .ok     { color: var(--brand); }

  .contribute-cta {
    padding-top: 32px;
    border-top: 1px solid var(--border);
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    transition: border-color 0.35s var(--transition);
  }

  .big-quote {
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    font-weight: 600;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.3;
    max-width: 560px;
  }

  @media (max-width: 900px) {
    .contribute-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .terminal {
      position: static;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var exploreBtn = document.querySelector('#contribute .contribute-cta .btn-primary');
    if (exploreBtn) {
      exploreBtn.addEventListener('click', function () {
        window.posthog?.capture('explore_repos_cta_clicked', { location: 'contribute' });
      });
    }
  });
</script>
