---
const steps = [
  {
    num: '01',
    title: 'Browse Issues',
    body: 'Explore open issues across our repositories. Filter by <code>good-first-issue</code> if you\'re new to open source.',
  },
  {
    num: '02',
    title: 'Fork & Build',
    body: 'Fork the repo, set it up locally using the README, and build your solution in a feature branch.',
  },
  {
    num: '03',
    title: 'Submit a PR',
    body: 'Open a pull request with a clear description. Our maintainers review within 48 hours.',
  },
  {
    num: '04',
    title: "You're In",
    body: "Once merged, you're an official contributor. Your GitHub history is your membership card.",
  },
];
---

<section class="section section-alt" id="contribute">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">02 — Join</span>
      <h2 class="section-title">How To Contribute</h2>
      <p class="section-desc">No applications. No interviews. No forms. You contribute, you're in.</p>
    </div>
    <div class="steps">
      {
        steps.map((step) => (
          <div class="step" data-reveal>
            <span class="step-num">{step.num}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p set:html={step.body} />
            </div>
          </div>
        ))
      }
    </div>
    <div class="contribute-cta" data-reveal>
      <p class="big-quote">"Your GitHub contribution history is your membership card."</p>
      <a href="https://github.com/voss-labs" class="btn btn-primary btn-large" target="_blank" rel="noopener">
        <span>Explore Repositories</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 100%;
    margin: 0 0 56px 0;
  }

  .step {
    display: flex;
    gap: 28px;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
    transition: border-color 0.35s var(--transition);
  }

  .step:first-child {
    padding-top: 0;
  }
  .step:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-muted);
    letter-spacing: -1px;
    padding: 0;
    background: none;
    border: none;
    opacity: 0.35;
    min-width: 44px;
    line-height: 1;
    flex-shrink: 0;
  }

  .step-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .step-content p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contribute-cta {
    text-align: left;
    padding-top: 56px;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .big-quote {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 28px;
    letter-spacing: -0.3px;
    max-width: 560px;
    line-height: 1.35;
  }
</style>
