---
const steps = [
  {
    num: '01',
    title: 'Browse open issues',
    body: 'Look across our repositories. Filter by <code>good-first-issue</code> if you\'re new.',
  },
  {
    num: '02',
    title: 'Pick something that fits',
    body: 'Match it to your skill level. <code>good-first-issue</code> for beginners, <code>intermediate</code> or <code>advanced</code> for the rest.',
  },
  {
    num: '03',
    title: 'Fork, build, submit a PR',
    body: 'Set up locally, build your solution in a feature branch, open a pull request with a clear description.',
  },
  {
    num: '04',
    title: "Get reviewed and merged",
    body: "We review within 48 hours. Once merged, you're a contributor. Your GitHub history is your membership card.",
  },
];
---

<section class="section" id="contribute">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">02 — Join</span>
      <h2 class="section-title">No applications. No interviews.</h2>
      <p class="section-desc">
        No forms, no committees, no gatekeepers. You contribute, you're in.
      </p>
    </div>
    <div class="steps">
      {
        steps.map((step) => (
          <div class="step" data-reveal>
            <span class="step-num">{step.num}</span>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p set:html={step.body} />
            </div>
          </div>
        ))
      }
    </div>
    <div class="contribute-cta" data-reveal>
      <p class="big-quote">Your GitHub contribution history is your membership card.</p>
      <a href="https://github.com/voss-labs" class="btn btn-primary btn-large" target="_blank" rel="noopener">
        <span>Explore Repositories</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0 0 80px 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .step {
    display: flex;
    gap: 32px;
    padding: 36px 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
    transition: border-color 0.35s var(--transition);
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-width: 56px;
    line-height: 1.6;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .step-content h3 {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 8px;
    color: var(--text);
  }

  .step-content p {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 640px;
  }

  .contribute-cta {
    padding-top: 0;
    text-align: left;
  }

  .big-quote {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 600;
    color: var(--text);
    margin-bottom: 36px;
    letter-spacing: -0.03em;
    line-height: 1.15;
    max-width: 720px;
  }

  @media (max-width: 768px) {
    .step {
      gap: 16px;
      padding: 28px 0;
    }
  }
</style>
