---
const items = [
  {
    num: '01',
    title: 'MIT License',
    body: 'Permissively licensed. Anyone can use, fork, or build on what we ship.',
  },
  {
    num: '02',
    title: 'Clear README',
    body: 'What the project does, how to run it, and where to find help — at the root of every repo.',
  },
  {
    num: '03',
    title: 'CONTRIBUTING.md',
    body: 'Setup instructions and contribution guidelines included from day one.',
  },
  {
    num: '04',
    title: 'Labeled Issues',
    body: '<code>good-first-issue</code>, <code>intermediate</code>, <code>advanced</code>, <code>bug</code>, <code>feature</code>, <code>docs</code> — every issue is sorted.',
  },
  {
    num: '05',
    title: 'Branch Protection',
    body: 'All changes to <code>main</code> go through pull requests with at least one review.',
  },
];
---

<section class="section" id="structure">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">03 — Standards</span>
      <h2 class="section-title">Every project follows the same baseline.</h2>
      <p class="section-desc">Consistency scales. New contributors find the same shape in every repo.</p>
    </div>
    <div class="standards" data-reveal>
      {
        items.map((item) => (
          <div class="standard-item">
            <span class="standard-num">{item.num}</span>
            <div class="standard-text">
              <h4>{item.title}</h4>
              <p set:html={item.body} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .standards {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .standard-item {
    display: flex;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .standard-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-width: 56px;
    line-height: 1.6;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .standard-text h4 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .standard-text p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .standard-item {
      gap: 16px;
    }
  }
</style>
