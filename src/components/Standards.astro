---
const items = [
  {
    num: '01',
    title: 'MIT License',
    body: 'Permissively licensed. Anyone can use, fork, or build on what we ship.',
  },
  {
    num: '02',
    title: 'Clear README',
    body: 'What the project does, how to run it, and where to find help — at the root of every repo.',
  },
  {
    num: '03',
    title: 'CONTRIBUTING.md',
    body: 'Setup instructions and contribution guidelines included from day one.',
  },
  {
    num: '04',
    title: 'Labeled Issues',
    body: '<code>good-first-issue</code>, <code>intermediate</code>, <code>advanced</code>, <code>bug</code>, <code>feature</code>, <code>docs</code>.',
  },
  {
    num: '05',
    title: 'Branch Protection',
    body: 'All changes to <code>main</code> go through pull requests with at least one review.',
  },
  {
    num: '06',
    title: 'Public Discussion',
    body: 'Design decisions happen in issues and PRs. Nothing important happens off-platform.',
  },
];
---

<section class="section" id="structure">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">03 — Standards</span>
      <h2 class="section-title">Every project follows the same baseline.</h2>
      <p class="section-desc">Consistency scales. Newcomers find the same shape in every repo.</p>
    </div>

    <div class="standards-grid" data-reveal>
      {
        items.map((item) => (
          <div class="standard">
            <div class="standard-head">
              <span class="standard-num">{item.num}</span>
              <h4>{item.title}</h4>
            </div>
            <p set:html={item.body} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .standards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .standard {
    padding: 24px 24px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .standard-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 12px;
  }

  .standard-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
  }

  .standard h4 {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .standard p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .standards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
