---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#contribute', label: 'Contribute' },
  { href: '#structure', label: 'Structure' },
  { href: '#values', label: 'Values' },
];

const connectLinks = [
  { href: 'https://github.com/voss-labs', label: 'GitHub', external: true },
  { href: 'mailto:hello@vosslabs.org', label: 'Email', external: false },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-wordmark">
          <span class="footer-name">VOSS</span>
          <span class="footer-accent" aria-hidden="true"></span>
        </div>
        <p class="footer-tag">
          <span>Vidyalankar</span>
          <span class="footer-tag-orange">Open Source</span>
          <span>Software Labs</span>
        </p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <h4>Navigate</h4>
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          {
            connectLinks.map((link) =>
              link.external ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ) : (
                <a href={link.href}>{link.label}</a>
              ),
            )
          }
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>Founded April 2026 · Vidyalankar Institute of Technology, Mumbai · Built in Public</p>
      <p>All projects released under MIT License unless otherwise specified.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 96px 0 48px;
    border-top: 1px solid var(--border);
    background: var(--bg);
    transition:
      background-color 0.35s var(--transition),
      border-color 0.35s var(--transition);
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 64px;
    flex-wrap: wrap;
    gap: 40px;
  }

  .footer-wordmark {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    margin-bottom: 8px;
  }

  .footer-name {
    font-family: var(--font-sans);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    color: var(--text);
  }

  .footer-accent {
    width: 12px;
    height: 12px;
    background: var(--brand-pure);
    display: block;
    margin-bottom: 3px;
  }

  .footer-tag {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .footer-tag-orange {
    color: var(--brand);
  }

  .footer-links {
    display: flex;
    gap: 64px;
  }

  .footer-col h4 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .footer-col a {
    display: block;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.92rem;
    margin-bottom: 10px;
    transition: color 0.2s var(--transition);
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    padding-top: 36px;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    text-align: left;
  }

  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin-bottom: 4px;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }
    .footer-links {
      gap: 40px;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.footer .footer-col a').forEach(function (link) {
      link.addEventListener('click', function () {
        var label = link.textContent?.trim() || '';
        var href = link.getAttribute('href') || '';
        window.posthog?.capture('footer_link_clicked', { link_label: label, link_href: href });
      });
    });
  });
</script>
