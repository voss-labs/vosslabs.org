---
const cards = [
  {
    num: '01',
    title: 'Campus Infrastructure',
    body: 'Attendance, notices, resources — the everyday machinery that keeps a college running. We make it work better.',
  },
  {
    num: '02',
    title: 'Department Portals',
    body: 'Dashboards and portals that departments actually want to log into. Fast, clean, built with real user feedback.',
  },
  {
    num: '03',
    title: 'Internal Tooling',
    body: 'CLI tools, GitHub bots, CI pipelines, and docs generators that make the lab itself more productive.',
  },
];
---

<section class="section" id="about">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">01 — What We Do</span>
      <h2 class="section-title">We fix what's broken.</h2>
      <p class="section-desc">
        We identify the most broken, manual, and painful systems at Vidyalankar — and we fix them with software.
        Every project is open source, publicly maintained on GitHub, and built for daily use.
      </p>
    </div>
    <div class="cards">
      {
        cards.map((card) => (
          <article class="card" data-reveal>
            <span class="card-num">{card.num}</span>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .card {
    background: transparent;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 40px 32px;
    transition: border-color 0.35s var(--transition);
  }

  .card:last-child {
    border-right: none;
  }

  .card-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 32px;
  }

  .card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }

  .card p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card {
      border-right: none;
      padding: 32px 0;
    }
  }
</style>
