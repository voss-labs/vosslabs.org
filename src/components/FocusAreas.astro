---
const cards = [
  {
    featured: true,
    title: 'Campus Infrastructure',
    body: 'Attendance systems, notice boards, resource allocators — the invisible machinery that keeps a college running. We make it work better.',
    tags: ['React', 'Node.js', 'PostgreSQL'],
    icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  },
  {
    featured: false,
    title: 'Department Portals',
    body: 'Dashboards and internal tools that departments actually want to log into. Clean, fast, and built with real user feedback.',
    tags: ['Next.js', 'Tailwind'],
    icon: '<path d="M12 20V10M18 20V4M6 20v-4"/>',
  },
  {
    featured: false,
    title: 'Dev Tooling',
    body: 'Internal CLI tools, GitHub bots, CI pipelines, and documentation generators that make the lab itself more productive.',
    tags: ['Go', 'Python', 'GitHub Actions'],
    icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  },
];
---

<section class="section" id="about">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">01 — Focus Areas</span>
      <h2 class="section-title">What We Do</h2>
      <p class="section-desc">We don't build for portfolios. We build for daily use.</p>
    </div>
    <div class="cards">
      {
        cards.map((card) => (
          <article class:list={['card', card.featured && 'card-featured']} data-reveal>
            <div class="card-icon">
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                set:html={card.icon}
              />
            </div>
            <h3>{card.title}</h3>
            <p>{card.body}</p>
            <div class="card-tags">
              {card.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 36px;
    transition:
      background-color 0.35s var(--transition),
      border-color 0.35s var(--transition);
  }

  .card:hover {
    border-color: var(--border-hover);
  }

  .card-featured {
    border-color: var(--border-hover);
  }

  .card-featured:hover {
    border-color: var(--text-muted);
  }

  .card-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 18px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-dim);
    background: transparent;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    transition: border-color 0.35s var(--transition);
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
