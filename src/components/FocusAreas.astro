---
const cards = [
  {
    num: '01',
    tag: 'Infrastructure',
    title: 'Campus tools that just work.',
    body: 'Attendance, notices, resources — the everyday machinery that keeps a college running. We make it work better, faster, and less painful for the students who use it every day.',
  },
  {
    num: '02',
    tag: 'Portals',
    title: 'Dashboards departments want to use.',
    body: 'Internal portals that load fast, look clean, and ship features users actually requested. Built with the people who will use them, not for a brochure.',
  },
  {
    num: '03',
    tag: 'Tooling',
    title: 'Tools to build the tools.',
    body: 'CLI utilities, GitHub bots, CI pipelines, and documentation generators that make the lab itself more productive. Meta-infrastructure, public from day one.',
  },
];
---

<section class="section" id="about">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">01 — What We Do</span>
      <h2 class="section-title">We fix what's broken.</h2>
      <p class="section-desc">
        We identify the most broken, manual, and painful systems at Vidyalankar — and we fix them with software.
        Every project is open source, publicly maintained on GitHub, and built for daily use.
      </p>
    </div>
    <div class="rows">
      {
        cards.map((card) => (
          <article class="row card" data-reveal>
            <div class="row-meta">
              <span class="row-num">{card.num}</span>
              <span class="row-tag">{card.tag}</span>
            </div>
            <div class="row-body">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 220px) 1fr;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
    align-items: start;
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 6px;
  }

  .row-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 500;
  }

  .row-tag {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--text);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .row-body h3 {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin-bottom: 10px;
    max-width: 640px;
  }

  .row-body p {
    color: var(--text-dim);
    font-size: 0.96rem;
    line-height: 1.5;
    max-width: 680px;
  }

  @media (max-width: 768px) {
    .row {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 36px 0;
    }
  }
</style>
