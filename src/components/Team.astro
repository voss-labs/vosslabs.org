---
const roles = [
  {
    badge: 'Founder',
    badgeClass: 'founder',
    title: 'Direction & Representation',
    body: "Sets the lab's vision and represents VOSS externally. One person, not a committee.",
  },
  {
    badge: 'Core Maintainers',
    badgeClass: 'core',
    title: 'Merge Access & Operations',
    body: 'Trusted contributors with admin rights. They keep the lights on and the merge queue moving.',
  },
  {
    badge: 'Maintainers',
    badgeClass: 'maintainer',
    title: 'Review & Mentorship',
    body: 'Review PRs, enforce standards, and help newcomers ship their first contribution.',
  },
  {
    badge: 'Contributors',
    badgeClass: 'contributor',
    title: 'Shippers of Code',
    body: 'Anyone with at least one merged PR. This is the majority of VOSS.',
  },
  {
    badge: 'Community',
    badgeClass: 'community',
    title: 'All VIT Students',
    body: 'Every student interested in open source is welcome to participate, learn, and grow.',
  },
];
---

<section class="section section-alt" id="team">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">04 — People</span>
      <h2 class="section-title">Who We Are</h2>
      <p class="section-desc">Flat structure. No elections. Your commits are your credentials.</p>
    </div>
    <div class="roles">
      {
        roles.map((role) => (
          <div class="role" data-reveal>
            <span class:list={['role-badge', role.badgeClass]}>{role.badge}</span>
            <h4>{role.title}</h4>
            <p>{role.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .roles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .role {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 32px;
    transition:
      background-color 0.35s var(--transition),
      border-color 0.35s var(--transition);
  }

  .role:hover {
    border-color: var(--border-hover);
  }

  .role-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0 0 4px 0;
    margin-bottom: 16px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .role-badge.founder,
  .role-badge.core,
  .role-badge.maintainer,
  .role-badge.contributor,
  .role-badge.community {
    color: var(--text-dim);
  }

  .role h4 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .role p {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .roles {
      grid-template-columns: 1fr;
    }
  }
</style>
