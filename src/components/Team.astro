---
const roles = [
  {
    num: '01',
    badge: 'Founder',
    body: 'Sets direction. Represents the lab externally. One person, not a committee.',
  },
  {
    num: '02',
    badge: 'Core Maintainers',
    body: 'Trusted contributors with merge access. Run day-to-day operations.',
  },
  {
    num: '03',
    badge: 'Maintainers',
    body: 'Experienced contributors who review PRs and mentor newcomers.',
  },
  {
    num: '04',
    badge: 'Contributors',
    body: 'Anyone who has shipped at least one merged contribution.',
  },
  {
    num: '05',
    badge: 'Community',
    body: 'All Vidyalankar students interested in open source. The widest circle.',
  },
];
---

<section class="section" id="team">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">04 — People</span>
      <h2 class="section-title">A flat, contribution-based structure.</h2>
      <p class="section-desc">
        No elected positions. No president, no secretary, no treasurer. Your commits are your credentials.
      </p>
    </div>
    <div class="roles" data-reveal>
      {
        roles.map((role) => (
          <div class="role">
            <span class="role-num">{role.num}</span>
            <div class="role-content">
              <h4>{role.badge}</h4>
              <p>{role.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .roles {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .role {
    display: flex;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .role-num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    min-width: 56px;
    line-height: 1.6;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .role-content h4 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 6px;
  }

  .role-content p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .role {
      gap: 16px;
    }
  }
</style>
