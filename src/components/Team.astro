---
const tiers = [
  {
    label: 'Direction',
    roles: [
      {
        num: '01',
        name: 'Founder',
        body: 'Sets direction. Represents the lab externally. One person, not a committee.',
      },
    ],
  },
  {
    label: 'Operations',
    roles: [
      {
        num: '02',
        name: 'Core Maintainers',
        body: 'Trusted contributors with merge access. Run day-to-day operations.',
      },
      {
        num: '03',
        name: 'Maintainers',
        body: 'Experienced contributors who review PRs and mentor newcomers.',
      },
    ],
  },
  {
    label: 'The Lab',
    roles: [
      {
        num: '04',
        name: 'Contributors',
        body: 'Anyone who has shipped at least one merged contribution.',
      },
      {
        num: '05',
        name: 'Community',
        body: 'All Vidyalankar students interested in open source. The widest circle.',
      },
    ],
  },
];
---

<section class="section" id="team">
  <div class="container">
    <div class="section-header" data-reveal>
      <span class="section-eyebrow">05 — People</span>
      <h2 class="section-title">A flat, contribution-based structure.</h2>
      <p class="section-desc">
        No elected positions. No president, no secretary, no treasurer. Your commits are your credentials.
      </p>
    </div>

    <div class="tiers">
      {
        tiers.map((tier) => (
          <div class="tier" data-reveal>
            <div class="tier-label">
              <span>{tier.label}</span>
            </div>
            <div class={`tier-roles cols-${tier.roles.length}`}>
              {tier.roles.map((role) => (
                <div class="role">
                  <div class="role-head">
                    <span class="role-num">{role.num}</span>
                    <h4>{role.name}</h4>
                  </div>
                  <p>{role.body}</p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tiers {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
    transition: border-color 0.35s var(--transition);
  }

  .tier {
    display: grid;
    grid-template-columns: minmax(0, 180px) 1fr;
    gap: 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
    transition: border-color 0.35s var(--transition);
  }

  .tier-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    padding-top: 6px;
  }

  .tier-roles {
    display: grid;
    gap: 24px;
  }

  .tier-roles.cols-1 {
    grid-template-columns: 1fr;
  }

  .tier-roles.cols-2 {
    grid-template-columns: 1fr 1fr;
  }

  .role-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 8px;
  }

  .role-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .role h4 {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .role p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 480px;
  }

  @media (max-width: 768px) {
    .tier {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .tier-roles.cols-2 {
      grid-template-columns: 1fr;
    }
  }
</style>
